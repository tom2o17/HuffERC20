// The stack works in a first in last out order
#define function owner() view returns (address)
#define function balanceOf(address) view returns (uint256)
#define function totalSupply() view returns (uint256)
#define function pendingOwner() view returns (address)
#define function mint(uint256) nonpayable returns ()
#define function transfer(address, uint256) nonpayable returns ()
#define function setPendingOwner(address) nonpayable returns ()
#define function acceptOwnership() nonpayable returns ()


/*
Memory map 
0x00 - balances 
0x01 - Owner slot
*/

// We save marginal cas by having this be declared 0x00
#define constant BALANCES_SLOT = 0x00
#define constant OWNER_SLOT = 0x01
#define constant TOTAL_SUPPLY_SLOT = 0x02


#define macro CONSTRUCTOR() = takes (0) returns (0) {
    caller [OWNER_SLOT] sstore  // Store msg.sender as owner
}

#define macro OWNABLE_GET_OWNER() = takes(0) returns(0) {
    [OWNER_SLOT] sload // Load owner address from storage and push it to the stack
    0x00 mstore        // Store owner to memeory at index 0x00
    0x20 0x00 return   // Exit context, return 0x20=32 bytes from memory, starting at memory index 0x00 
}


#define macro ACCESS_ONLY_OWNER() = takes(0) returns (0) {
    [OWNER_SLOT] sload caller eq is_owner jumpi
        0x00 0x00 revert
    is_owner:
}

#define macro ADDRESS_MASK() = takes (1) returns (1) {
	0x000000000000000000000000ffffffffffffffffffffffffffffffffffffffff
	and
}


#define macro BALANCE_OF() = takes(0) returns(0) {
    0x04 calldataload
    ADDRESS_MASK()
    0x00
    mstore
    0x40 0x00 sha3
    sload
    0x00
    mstore
    0x20 0x00 return
}

#define macro TOTAL_SUPPLY() = takes(0) returns(0) {
    [TOTAL_SUPPLY_SLOT]
    sload
    0x00 mstore
    0x20 0x00 return
}


#define macro TRANSFER() = takes(0) returns(0) {
    // 0x24 calldataload
    // caller
    // 0x00
    // mstore
    // 0x40 0x00 sha3
    // sload
    // sub
    // 0x40 0x00 sha3
    // sstore
    
    // More efficient than computing the hash twice
    0x24 calldataload
    caller
    0x00
    mstore
    0x40 0x00 sha3
    swap1
    dup2
    sload
    sub
    swap1
    sstore
    // We have decremented their balance

}



#define macro MINT_USER() = takes(0) returns(0) {
    caller 
    0x00   
    mstore
    0x40 0x00 sha3 
    dup1
    sload // [balanceOf[caller], key]
    0x04 calldataload
    add // [balanceOf[caller] + value, key]
    swap1
    sstore

    // // Increment balance of TS
    // [TOTAL_SUPPLY_SLOT] // [0x02]
    // dup1                // [0x02, 0x02]
    // sload               // [Ts val, 0x02 ]
    // 0x04 calldataload   //[value, TS val, 0x02] 
    // add                 // [new TS, 0x02]
    // swap1
    // sstore
    
    // More efficient solution
    // Increment balance of TS
    [TOTAL_SUPPLY_SLOT] // [0x02]
    sload               // [Ts val, 0x02 ]
    0x04 calldataload   //[value, TS val, 0x02] 
    add                 // [new TS, 0x02]
    [TOTAL_SUPPLY_SLOT]
    sstore
}



#define macro MAIN() = takes (0) returns (0) {
    // callvalue throw_error jumpi // Revert if eth send

    0x00 calldataload 0xE0 shr // Get function signature

    dup1 __FUNC_SIG(owner) eq get_owner jumpi
    dup1 __FUNC_SIG(balanceOf) eq get_balance jumpi
    dup1 __FUNC_SIG(mint) eq mint jumpi
    dup1 __FUNC_SIG(totalSupply) eq total_supply jumpi
    dup1 __FUNC_SIG(transfer) eq transfer jumpi

    // throw_error:
    //     0x00 0x00 revert

    // If the function sig is not recognized then this
    // is the default/fallback function.
    get_owner:
        OWNABLE_GET_OWNER()
    get_balance:
        BALANCE_OF()
    mint:
        ACCESS_ONLY_OWNER()
        MINT_USER()
    total_supply:
        TOTAL_SUPPLY()
    transfer:
        TRANSFER()
}